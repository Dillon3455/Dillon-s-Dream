---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { postTitle } from '../lib/posts';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '') + '/';

const all = await getCollection('blog');
const notes = all.filter((p) => p.id.startsWith('verse/'));
notes.sort((a, b) => postTitle(a).localeCompare(postTitle(b), 'ru'));
const total = notes.length;

// Буквенный указатель.
const LETTER = /[\p{L}\p{N}]/u;
function letterOf(title: string): string {
	const t = title?.trim();
	if (!t) return '#';
	const c = t[0];
	return LETTER.test(c) ? c.toUpperCase() : '#';
}
const letters = new Map<string, typeof notes>();
for (const p of notes) {
	const L = letterOf(postTitle(p));
	if (!letters.has(L)) letters.set(L, []);
	letters.get(L)!.push(p);
}
const letterGroups = [...letters.entries()].sort((a, b) => {
	if (a[0] === '#') return 1;
	if (b[0] === '#') return -1;
	return a[0].localeCompare(b[0], 'ru');
});

// Группировка по категориям (из frontmatter). Без категории → «Разное».
const cats = new Map<string, number>();
for (const p of notes) {
	const c = (p.data.category ?? '').trim() || 'Разное';
	cats.set(c, (cats.get(c) ?? 0) + 1);
}
const categoryList = [...cats.entries()].sort((a, b) => {
	if (a[0] === 'Разное') return 1;
	if (b[0] === 'Разное') return -1;
	return a[0].localeCompare(b[0], 'ru');
});

function href(id: string): string {
	const slug = id.replace(/^verse\//, '').split('/').pop()!.toLowerCase();
	return `${base}verse/${slug}/`;
}
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={`Verse · ${SITE_TITLE}`} description={`Личная база знаний — ${total} статей сети «Verse».`} />
	</head>
	<body class="min-h-screen flex flex-col bg-[#171717] text-zinc-200 antialiased">
		<Header />
		<main class="mx-auto w-full max-w-4xl px-4 pb-16 pt-12 flex-1">
			{/* Шапка хаба */}
			<header class="mb-10">
				<p class="mb-3 text-xs font-medium uppercase tracking-[0.35em] text-sky-300/80">Verse</p>
				<h1 class="border-b-2 border-[#0080FF] pb-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
					База знаний
				</h1>
				<div class="mt-4 inline-flex items-center gap-2 rounded-full border border-[#0080FF]/40 bg-[#0080FF]/10 px-3.5 py-1.5 text-sm text-white">
					<span class="h-2 w-2 rounded-full bg-[#0080FF]"></span>
					Всего статей: <strong class="font-semibold">{total}</strong>
				</div>
				<p class="mt-3 text-base text-zinc-400">
					Личная википедия о вайбкодинге, Astro и творческой разработке с ИИ.
					Каждая карточка ведёт на страницу статьи — выбирай по алфавиту или по категории.
				</p>
			</header>

			{/* Быстрый буквенный указатель */}
			<nav class="mb-8 flex flex-wrap items-center gap-1.5" aria-label="Алфавитный указатель">
				{
					letterGroups.map(([L]) => (
						<a
							href={`#letter-${encodeURIComponent(L)}`}
							class="grid h-8 w-8 place-items-center rounded-lg border border-white/[0.1] text-sm font-medium text-zinc-300 transition hover:border-[#0080FF] hover:bg-[#0080FF]/10 hover:text-white"
						>
							{L}
						</a>
					))
				}
			</nav>

			 {/* Категории */ }
			<section class="mb-10 rounded-2xl border border-white/[0.08] bg-[#1b1b1b] p-5">
				<h2 class="mb-3 text-sm font-bold uppercase tracking-[0.15em] text-white">Категории</h2>
				<div class="flex flex-wrap gap-2">
					{
						categoryList.map(([c, n]) => (
							<span class="inline-flex items-center gap-1.5 rounded-full border border-[#0080FF]/30 bg-[#0080FF]/10 px-3 py-1 text-sm text-sky-200">
								{c}
								<span class="text-xs text-zinc-400">({n})</span>
							</span>
						))
					}
				</div>
			</section>

			 {/* Список статей по алфавиту */ }
			<section class="space-y-6">
				{
					letterGroups.map(([L, posts], gi) => (
						<div id={`letter-${encodeURIComponent(L)}`} class="rounded-2xl bg-[#1b1b1b] p-5">
							<div class="flex items-center justify-between gap-3">
								<span class="grid h-9 w-9 place-items-center rounded-xl bg-[#0080FF]/15 text-lg font-bold text-white">{L}</span>
								<span class="text-xs font-medium uppercase tracking-wider text-zinc-500">
									{posts.length} {posts.length === 1 ? 'статья' : posts.length < 5 ? 'статьи' : 'статей'}
								</span>
							</div>
							<ol class="mt-3 space-y-1.5">
								{
									posts.map((p) => (
										<li>
											<a href={href(p.id)} class="group flex items-start justify-between gap-2 rounded-lg px-3 py-2.5 transition hover:bg-white/[0.06]">
												<span class="text-base font-medium text-zinc-200 group-hover:text-white">{postTitle(p)}</span>
												<span class="shrink-0 text-xs uppercase text-zinc-500">{p.data.category || 'Разное'}</span>
											</a>
										</li>
									))
								}
							</ol>
							{gi < letterGroups.length - 1 && <hr class="mt-2 border-white/[0.06]" />}
						</div>
					))
				}
			</section>
		</main>
			<Footer />
			</body>
			</html>