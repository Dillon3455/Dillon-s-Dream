---
import { SITE_TITLE } from '../consts';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '') + '/';
const path = Astro.url.pathname;

const links = [
	{ href: base, label: 'Home' },
	{ href: `${base}verse/`, label: 'Verse' },
	{ href: `${base}about/`, label: 'About' },
];
---

<header class="sticky top-0 z-50 bg-[#0080FF]">
	<nav class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
		<span class="text-sm font-semibold tracking-tight text-white">
			{SITE_TITLE}
			<span class="ml-1.5 inline-block h-1.5 w-1.5 rounded-full bg-white/90 align-middle"></span>
		</span>
		<div class="flex items-center gap-1">
			{
				links.map((l) => {
					const isHome = l.href === base;
					const active = isHome ? path === base : path.startsWith(l.href);
					return (
						<a
							href={l.href}
							class:list={[
								'rounded-full px-3.5 py-1.5 text-sm font-medium transition',
								active ? 'bg-white/20 text-white' : 'text-white/80 hover:bg-white/10 hover:text-white',
							]}
						>
							{l.label}
						</a>
					);
				})
			}
		</div>
	</nav>
</header>