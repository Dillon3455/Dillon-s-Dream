---
// WikiLayout.astro — Fandom-подобный макет страниц Verse:
// содержание (TOC) слева + читаемая статья + инфобокс справа.
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { humanize } from '../lib/posts';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '') + '/';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Data = {
	slug?: string;
	title?: string;
	description?: string;
	heroImage?: ImageMetadata;
	category?: string;
	type?: string;
	status?: string;
	author?: string;
	tags?: string | string[];
	pubDate?: Date;
	date?: Date;
	headings?: Heading[];
};
const props = Astro.props as Data;

const headings = (props.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

const finalTitle = props.title?.trim() || (props.slug ? humanize(props.slug) : 'Статья');
const fallbackDesc = `Статья «${finalTitle}» в базе знаний Verse.`;
const finalDescription = props.description?.trim() || fallbackDesc;
const mainDate = props.pubDate ?? props.date;

const tags = Array.isArray(props.tags) ? props.tags : props.tags ? [props.tags] : [];
const hasInfobox =
	props.type || props.status || props.author || props.category || tags.length || mainDate || props.heroImage;
---
<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={finalTitle} description={finalDescription} />
	</head>
	<body class="min-h-screen bg-[#171717] text-zinc-200 antialiased">
		<Header />

		{/* ===== Мобильная (схлопываемая) навигация ===== */}
		<details class="mb-2 rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-4 py-3 lg:hidden">
			<summary class="cursor-pointer text-sm font-semibold text-zinc-200">
				Содержание <span class="text-zinc-500">({headings.length})</span>
			</summary>
			<ul class="mt-2 space-y-1 text-sm">
				{
					headings.map((h) => (
						<li>
							<a href={`#${h.slug}`} class="text-zinc-400 transition-colors hover:text-[#0080FF]">
								{h.text}
							</a>
						</li>
					))
				}
			</ul>
		</details>

		<main class="mx-auto grid w-full max-w-7xl items-start gap-8 px-4 pb-16 pt-10 lg:grid-cols-[15rem_minmax(0,1fr)_16rem] md:grid-cols-[15rem_minmax(0,1fr)]">
			{/* ===== Левая колонка: содержание статьи (Table of Contents) ===== */}
			<aside class="sticky top-[4.7rem] max-h-[calc(100vh-6rem)] self-start overflow-y-auto rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-4 py-5">
				<p class="mb-1 text-xs font-medium uppercase tracking-[0.3em] text-sky-300/80">Verse</p>
				<p class="mb-3 text-sm font-semibold text-zinc-200">Содержание</p>
				<ul class="space-y-1">
					{
						headings.map((h) => (
							<li>
								<a
									href={`#${h.slug}`}
									class:list={[
										'block text-zinc-400 hover:text-[#0080FF] transition-colors',
										h.depth === 3 ? 'pl-4 text-xs' : 'text-sm font-medium',
									]}
								>
									{h.text}
								</a>
							</li>
						))
					}
				</ul>
			</aside>

			{/* ===== Центральная колонка: статья ===== */}
			<article class="min-w-0 rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-8 py-10 sm:px-12">
				<header class="mb-6">
					{mainDate && (
						<div class="mb-3 text-xs font-medium uppercase tracking-widest text-zinc-500">
							<FormattedDate date={mainDate} />
						</div>
					)}
					<h1 class="border-b-2 border-[#0080FF] pb-3 text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl">
						{finalTitle}
					</h1>
					{finalDescription !== fallbackDesc && <p class="mt-3 text-base text-zinc-400">{finalDescription}</p>}
				</header>

				<div class="article">
					<slot />
				</div>

				<footer class="mt-10 border-t border-white/[0.1] pt-4 text-xs text-zinc-600">
					Категория: {props.category || 'Разное'} · из базы знаний Verse
				</footer>
			</article>

			{/* ===== Правая колонка: инфобокс ===== */}
			{
				hasInfobox && (
					<aside class="sticky top-[4.7rem] self-start rounded-2xl border-2 border-[#0080FF] bg-[#141414] px-5 py-4">
						<div class="mb-2 flex items-center gap-2 border-b border-[#0080FF]/40 pb-2">
							<span class="h-2.5 w-2.5 rounded-full bg-[#0080FF]"></span>
							<h2 class="text-sm font-bold uppercase tracking-[0.15em] text-white">Инфобокс</h2>
						</div>
						{props.heroImage && (
							<div class="mb-3 overflow-hidden rounded-xl border border-[#0080FF]/30">
								<Image width={480} height={270} src={props.heroImage} alt="" class="w-full" />
							</div>
						)}
						<div class="space-y-1">
							{props.type && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Тип</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.type}</span>
								</div>
							)}
							{props.status && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Статус</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.status}</span>
								</div>
							)}
							{props.author && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Автор</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.author}</span>
								</div>
							)}
							{props.category && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Категория</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.category}</span>
								</div>
							)}
							{mainDate && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Дата</span>
									<span class="text-right text-sm font-medium text-zinc-200"><FormattedDate date={mainDate} /></span>
								</div>
							)}
							{tags.length > 0 && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Теги</span>
									<span class="text-right text-sm font-medium text-zinc-200">{tags.join(', ')}</span>
								</div>
							)}
						</div>
					</aside>
				)
			}
		</main>
	</body>
</html>
