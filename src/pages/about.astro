---
import { getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { postDescription, postTitle } from '../lib/posts';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

const posts = await getCollection('blog');
const entry = posts.find((p) => p.id === 'about');
const { Content } = await render(entry);
const title = postTitle(entry);
const description = postDescription(entry);
---

<BlogPost title={title} description={description} slug="about" pubDate={undefined}>
	<Content />
</BlogPost>