---
// No build-time logic needed
---

<button
  id="back-to-top"
  class="fixed bottom-0 right-10 z-[100] flex flex-col items-end gap-2 -translate-y-full opacity-0 pointer-events-none transition-all duration-300 ease-out min-h-[300px]"
  aria-label="Наверх"
>
  <!-- Spacer: pushes cords up and gives button height for translate-y-full to hide -->
  <div class="h-[200px]"></div>
  <!-- Cords: tops fixed ~150px from bottom, hang DOWN, balls at bottom ends -->
  <div class="flex flex-col items-end gap-2 -translate-y-[150px]">
    <!-- Left (longer) cord -->
    <div class="flex flex-col items-center">
      <div class="w-[3px] h-24 bg-[#7ABEFF] rounded-full"></div>
      <div class="w-3 h-3 rounded-full bg-white mt-0.5" style="box-shadow: 0 0 10px #fff;"></div>
    </div>
    <!-- Right (shorter) cord -->
    <div class="flex flex-col items-center">
      <div class="w-[3px] h-16 bg-[#7ABEFF] rounded-full"></div>
      <div class="w-3 h-3 rounded-full bg-white mt-0.5" style="box-shadow: 0 0 10px #fff;"></div>
    </div>
  </div>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  if (!btn) throw new Error('[BackToTop] button not found');

  let visible = false;

  function show() {
    if (visible) return;
    visible = true;
    btn.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
    btn.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
  }

  function hide() {
    if (!visible) return;
    visible = false;
    btn.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
    btn.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
  }

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) show();
    else hide();
  });

  btn.addEventListener('click', () => {
    btn.classList.add('animate-btt-pull');
    btn.style.transitionDuration = '0ms';

    window.scrollTo({ top: 0, behavior: 'smooth' });

    setTimeout(() => {
      btn.classList.remove('animate-btt-pull');
      btn.style.transitionDuration = '';
    }, 350);
  });
</script>

<style>
  @keyframes btt-pull {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(18px); }
    55%  { transform: translateY(-3px); }
    100% { transform: translateY(0); }
  }
  .animate-btt-pull {
    animation: btt-pull 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>