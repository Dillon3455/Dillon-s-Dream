---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { postDate, postDescription, postTitle, sortPosts } from '../../lib/posts';

const posts = sortPosts(await getCollection('blog'));
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={`Все заметки · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-[#09090b] text-zinc-200 antialiased">
		<Header />
		<main class="mx-auto w-full max-w-5xl px-6 pb-28 pt-20">
			<header class="mb-12">
				<p class="mb-3 text-xs font-medium uppercase tracking-[0.35em] text-violet-300/80">Архив</p>
				<h1 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
					Все заметки <span class="text-zinc-500">({posts.length})</span>
				</h1>
			</header>

			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="group flex flex-col rounded-2xl border border-white/[0.06] bg-[#0d0d11] p-6 transition duration-300 hover:-translate-y-1 hover:border-white/[0.14] hover:bg-[#111116]"
						>
							<div class="mb-3 text-xs font-medium uppercase tracking-widest text-zinc-500">
								<FormattedDate date={postDate(post)} />
							</div>
							<h3 class="mb-2 text-lg font-semibold leading-snug text-zinc-100 transition group-hover:text-white">
								{postTitle(post)}
							</h3>
							<p class="mt-auto text-sm leading-relaxed text-zinc-400 line-clamp-3">
								{postDescription(post)}
							</p>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>