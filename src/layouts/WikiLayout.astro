---
// WikiLayout.astro — Fandom-подобный макет страниц Verse:
// содержание (TOC) слева + читаемая статья + инфобокс справа.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { resolveSlug } from '../lib/wikiLinks.mjs';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { humanize } from '../lib/posts';
import fs from 'node:fs';
import path from 'node:path';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '') + '/';

type Heading = {
	depth: number;
	slug: string;
	text: string;
};

type Data = {
	slug?: string;
	title?: string;
	description?: string;
	heroImage?: ImageMetadata;
	category?: string;
	type?: string;
	status?: string;
	author?: string;
	number?: number;
	tags?: string | string[];
	pubDate?: Date;
	date?: Date;
	headings?: Heading[];
};
const props = Astro.props as Data;

const headings = (props.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

const finalTitle = props.title?.trim() || (props.slug ? humanize(props.slug) : 'Статья');
const fallbackDesc = `Статья «${finalTitle}» в базе знаний Verse.`;
const finalDescription = props.description?.trim() || fallbackDesc;
const mainDate = props.pubDate ?? props.date;

const tags = Array.isArray(props.tags) ? props.tags : props.tags ? [props.tags] : [];

// ---- Обратные ссылки (Backlinks): кто ссылается на эту заметку ----
// Сканер работает на сыром markdown-тексте (без рендера), чтобы не зависеть
// от внутреннего представления satteri. Использует тот же resolveSlug,
// что и Hast-плагин — формат ссылок в итоговом HTML гарантированно совпадёт.
// Файлы читаются через node:fs напрямую — это не зависит от internals
// Astro-глоба и работает одинаково в dev и build.
const CONTENT_DIR = path.resolve(process.cwd(), 'src/content/blog/verse');
function walk(dir: string): string[] {
	const out: string[] = [];
	for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
		const full = path.join(dir, entry.name);
		if (entry.isDirectory()) out.push(...walk(full));
		else if (entry.isFile() && /\.(md|mdx)$/i.test(entry.name)) out.push(full);
	}
	return out;
}
const sourceFiles: Record<string, string> = {};
for (const full of walk(CONTENT_DIR)) {
	const rel = path.relative(CONTENT_DIR, full).replace(/\\/g, '/'); // e.g. dillons/dillon.md
	const slug = rel.replace(/\.(md|mdx)$/i, ''); // e.g. dillons/dillon
	try {
		sourceFiles[`verse/${slug}`] = fs.readFileSync(full, 'utf-8');
	} catch { /* skip */ }
}
const GLOB_KEYS = Object.keys(sourceFiles);
if (GLOB_KEYS.length === 0) {
	throw new Error('[backlinks] no verse files found under ' + CONTENT_DIR);
}

const currentSlug = (props.slug ?? '').replace(/^verse\//, '').toLowerCase();
const allPosts = await getCollection('blog');
const versePosts = allPosts.filter((p) => p.id.startsWith('verse/'));
const backlinks: { title: string; href: string }[] = [];

// Извлекает все markdown-ссылки [text](target) из текста.
const LINK_RE = /\[[^\]]*\]\(([^)]+)\)/g;

// Нормализует путь из glob-ключа к вики-слагу: `../../content/blog/verse/start.md` → `verse/start`.
function slugFromGlobKey(key: string): string {
	return key
		.replace(/^\.\/+/, '')
		.replace(/^.*?content\/blog\//, '')
		.replace(/\.(mdx?)$/i, '')
		.split('/')
		.pop()!
		.toLowerCase();
}

if (currentSlug) {
		for (const [key, src] of Object.entries(sourceFiles)) {
			const slug = slugFromGlobKey(key);
			if (!slug) continue;
			// slug — плоский basename (например, `start`), currentSlug — тоже.
			if (slug === currentSlug) continue;

			let found = false;
			for (const m of src.matchAll(LINK_RE)) {
				if (resolveSlug(m[1])?.toLowerCase() === currentSlug) {
					found = true;
					break;
				}
			}
			if (!found) continue;

			// Находим соответствующую запись в коллекции по плоскому slug.
			const post = versePosts.find((p) => p.id.replace(/^verse\//, '').split('/').pop()!.toLowerCase() === slug);
			backlinks.push({
				title: post?.data.title?.trim() || slug,
				href: `${base}verse/${slug}/`,
			});
		}
	}
backlinks.sort((a, b) => a.title.localeCompare(b.title, 'ru'));
const hasInfobox =
	props.type || props.status || props.author || props.category || tags.length || mainDate || props.heroImage;
---
<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={finalTitle} description={finalDescription} />
	</head>
	<body class="min-h-screen bg-[#171717] text-zinc-200 antialiased">
		<Header />

		{/* ===== Мобильная (схлопываемая) навигация ===== */}
		<details class="mb-2 rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-4 py-3 lg:hidden">
			<summary class="cursor-pointer text-sm font-semibold text-zinc-200">
				Содержание <span class="text-zinc-500">({headings.length})</span>
			</summary>
			<ul class="mt-2 space-y-1 text-sm">
				{
					headings.map((h) => (
						<li>
							<a href={`#${h.slug}`} class="text-zinc-400 transition-colors hover:text-[#0080FF]">
								{h.text}
							</a>
						</li>
					))
				}
			</ul>
		</details>

		<main class="mx-auto grid w-full max-w-7xl items-start gap-8 px-4 pb-16 pt-10 lg:grid-cols-[15rem_minmax(0,1fr)_16rem] md:grid-cols-[15rem_minmax(0,1fr)]">
			{/* ===== Левая колонка: содержание статьи (Table of Contents) ===== */}
			<aside class="sticky top-[4.7rem] max-h-[calc(100vh-6rem)] self-start overflow-y-auto rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-4 py-5">
				<p class="mb-1 text-xs font-medium uppercase tracking-[0.3em] text-sky-300/80">Verse</p>
				<p class="mb-3 text-sm font-semibold text-zinc-200">Содержание</p>
				<ul class="space-y-1">
					{
						headings.map((h) => (
							<li>
								<a
									href={`#${h.slug}`}
									class:list={[
										'block text-zinc-400 hover:text-[#0080FF] transition-colors',
										h.depth === 3 ? 'pl-4 text-xs' : 'text-sm font-medium',
									]}
								>
									{h.text}
								</a>
							</li>
						))
					}
				</ul>
			</aside>

			{/* ===== Центральная колонка: статья ===== */}
			<article class="min-w-0 rounded-2xl border border-white/[0.08] bg-[#1b1b1b] px-8 py-10 sm:px-12">
				<header class="mb-6">
					{mainDate && (
						<div class="mb-3 text-xs font-medium uppercase tracking-widest text-zinc-500">
							<FormattedDate date={mainDate} />
						</div>
					)}
					<h1 class="border-b-2 border-[#0080FF] pb-3 text-3xl font-semibold leading-tight tracking-tight text-white sm:text-4xl">
						{finalTitle}
					</h1>
					{finalDescription !== fallbackDesc && <p class="mt-3 text-base text-zinc-400">{finalDescription}</p>}
				</header>

				<div class="article">
							<slot />
						</div>

						{backlinks.length > 0 && (
							<div class="mt-8 rounded-xl border border-white/[0.08] bg-[#1b1b1b] px-5 py-4">
								<div class="mb-2 flex items-center gap-2">
									<span class="h-2 w-2 rounded-full bg-[#0080FF]"></span>
									<h3 class="text-sm font-bold uppercase tracking-[0.15em] text-white">
										На эту страницу ссылаются
									</h3>
								</div>
								<ul class="space-y-1.5">
									{backlinks.map((b) => (
										<li>
											<a
												href={b.href}
												class="group flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-[#0080FF]"
											>
												<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#0080FF]/50 group-hover:bg-[#0080FF]"></span>
												<span class="group-hover:underline">{b.title}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						)}

						{tags.length > 0 && (
							<div class="mt-6 flex flex-wrap items-center gap-2">
								<span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Категории:</span>
								{tags.map((t) => (
									<a
										href={`${base}verse/categories/${encodeURIComponent(t)}/`}
										class="inline-flex items-center gap-1.5 rounded-full border border-[#0080FF]/40 bg-[#0080FF]/10 px-3 py-1 text-xs font-medium text-sky-200 transition-colors hover:bg-[#0080FF]/20 hover:text-white"
									>
										{t}
									</a>
								))}
							</div>
						)}


					</article>

			{/* ===== Правая колонка: инфобокс ===== */}
			{
				hasInfobox && (
					<aside class="sticky top-[4.7rem] self-start rounded-2xl border-2 border-[#0080FF] bg-[#141414] px-5 py-4">
						<div class="mb-2 flex items-center gap-2 border-b border-[#0080FF]/40 pb-2">
							<span class="h-2.5 w-2.5 rounded-full bg-[#0080FF]"></span>
							<h2 class="text-sm font-bold uppercase tracking-[0.15em] text-white">Инфобокс</h2>
						</div>
						{props.heroImage && (
							<div class="mb-3 overflow-hidden rounded-xl border border-[#0080FF]/30">
								<Image width={480} height={270} src={props.heroImage} alt="" class="w-full" />
							</div>
						)}
						<div class="space-y-1">
							{props.type && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Тип</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.type}</span>
								</div>
							)}
							{props.status && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Статус</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.status}</span>
								</div>
							)}
							{props.author && (
								<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
									<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Автор</span>
									<span class="text-right text-sm font-medium text-zinc-200">{props.author}</span>
								</div>
							)}
							{props.category && (
											<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
												<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Категория</span>
												<span class="text-right text-sm font-medium text-zinc-200">{props.category}</span>
											</div>
										)}
										{props.number && (
											<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
												<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Номер</span>
												<span class="text-right text-sm font-medium text-zinc-200">{props.number}</span>
											</div>
										)}
										{mainDate && (
																													<div class="flex items-start justify-between gap-3 border-b border-[#0080FF]/20 py-2.5">
																														<span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-zinc-500">Дата</span>
																														<span class="text-right text-sm font-medium text-zinc-200"><FormattedDate date={mainDate} /></span>
																													</div>
																												)}

																				</div>
					</aside>
				)
			}
		</main>
	</body>
</html>
