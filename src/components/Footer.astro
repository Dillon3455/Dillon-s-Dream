---
import { execSync } from 'node:child_process';

function getBuildInfo(): { hash: string; date: string } {
  let hash = '??????';
  let date = '01.01.1970';

  try {
    const projectRoot = import.meta.env.PROJECT_ROOT_DIR || process.cwd();
    hash = execSync('git rev-parse --short HEAD', {
      encoding: 'utf-8',
      cwd: projectRoot,
      stdio: 'pipe',
    }).trim();
  } catch {
    // git unavailable or not a repo — keep fallback
  }

  try {
    const d = new Date();
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yyyy = d.getFullYear();
    date = `${dd}.${mm}.${yyyy}`;
  } catch {
    // keep fallback
  }

  return { hash, date };
}

const { hash, date } = getBuildInfo();
---

<footer
  id="app-footer"
  class="relative w-full mt-auto bg-[#0080FF] py-3 text-center opacity-0 pointer-events-none transition-all duration-500 translate-y-4"
  role="contentinfo"
>
  <p class="text-xs font-medium text-white/90">
    Сборка: #{hash} • Дата: {date}
  </p>

  <!-- Шнуры: крепятся к верхнему правому краю синей полосы футера -->
  <div
    id="back-to-top"
    class="absolute top-0 right-12 flex gap-4 items-start cursor-pointer"
    aria-label="Наверх"
  >
    <!-- Левый (длинный) шнур: шарик сверху парит над синей линией, нить уходит вниз -->
    <div class="flex flex-col items-center">
      <div class="w-3 h-3 bg-white rounded-full shadow-[0_0_12px_5px_rgba(255,255,255,0.8)] z-10 -mt-6"></div>
      <div class="w-[3px] h-24 bg-[#7ABEFF]"></div>
    </div>
    <!-- Правый (короткий) шнур: шарик сверху, короткая нить уходит вниз -->
    <div class="flex flex-col items-center">
      <div class="w-3 h-3 bg-white rounded-full shadow-[0_0_12px_5px_rgba(255,255,255,0.8)] z-10 -mt-6"></div>
      <div class="w-[3px] h-14 bg-[#7ABEFF]"></div>
    </div>
  </div>
</footer>

<script>
  const footer = document.getElementById('app-footer');
  const btn = document.getElementById('back-to-top');
  if (!footer || !btn) throw new Error('[Footer] elements not found');

  let visible = false;

  function show() {
    if (visible) return;
    visible = true;
    footer.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    footer.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
  }

  function hide() {
    if (!visible) return;
    visible = false;
    footer.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    footer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
  }

  function checkBottom() {
    const atBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 50;
    if (atBottom) show();
    else hide();
  }

  window.addEventListener('scroll', checkBottom, { passive: true });

  btn.addEventListener('click', () => {
    btn.classList.add('animate-btt-pull');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => {
      btn.classList.remove('animate-btt-pull');
    }, 500);
  });
</script>

<style>
  @keyframes btt-pull {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(15px); }
    50%  { transform: translateY(-4px); }
    75%  { transform: translateY(8px); }
    100% { transform: translateY(0); }
  }
  .animate-btt-pull {
    animation: btt-pull 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>