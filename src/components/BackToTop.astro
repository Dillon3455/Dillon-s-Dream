---
// No build-time logic needed
---

<div
  id="back-to-top"
  class="fixed bottom-24 right-12 z-50 flex gap-4 items-start cursor-pointer transition-all duration-500 opacity-0 pointer-events-none -translate-y-4"
  aria-label="Наверх"
>
  <!-- Left (longer) cord: ball on top, blue line below -->
  <div class="flex flex-col items-center">
    <div class="w-3 h-3 bg-white rounded-full shadow-[0_0_12px_5px_rgba(255,255,255,0.8)] z-10"></div>
    <div class="w-[3px] h-24 bg-[#7ABEFF]"></div>
  </div>
  <!-- Right (shorter) cord: ball on top, shorter blue line below -->
  <div class="flex flex-col items-center">
    <div class="w-3 h-3 bg-white rounded-full shadow-[0_0_12px_5px_rgba(255,255,255,0.8)] z-10"></div>
    <div class="w-[3px] h-14 bg-[#7ABEFF]"></div>
  </div>
</div>

<script>
  const btn = document.getElementById('back-to-top');
  if (!btn) throw new Error('[BackToTop] button not found');

  let visible = false;

  function show() {
    if (visible) return;
    visible = true;
    btn.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
    btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
  }

  function hide() {
    if (!visible) return;
    visible = false;
    btn.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
    btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
  }

  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) show();
    else hide();
  });

  btn.addEventListener('click', () => {
    btn.classList.add('animate-btt-pull');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => {
      btn.classList.remove('animate-btt-pull');
    }, 500);
  });
</script>

<style>
  @keyframes btt-pull {
    0%   { transform: translateY(0); }
    25%  { transform: translateY(15px); }
    50%  { transform: translateY(-4px); }
    75%  { transform: translateY(8px); }
    100% { transform: translateY(0); }
  }
  .animate-btt-pull {
    animation: btt-pull 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>