---
import { SITE_TITLE } from '../consts';
import logo from '../assets/logo.png';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '') + '/';
const path = Astro.url.pathname;

const links = [
	{ href: base, label: 'Home' },
	{ href: `${base}verse/start/`, label: 'Verse' },
	{ href: `${base}about/`, label: 'About' },
];
---
<header class="sticky top-0 z-50 bg-[#0080FF]">
	<nav class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
		<div class="flex items-center gap-3">
			<img src={logo} alt="Logo" class="h-10 w-10 object-contain" />
			<a
				href={base}
				class:list={[
					'rounded-full bg-[#171717] px-4 py-2 text-sm font-medium text-white transition-all hover:bg-gray-800',
					path === base ? 'ring-1 ring-white/40' : '',
				]}
			>
				{SITE_TITLE}
			</a>
		</div>
		<div class="flex items-center gap-1">
			{
				links.map((l) => {
					const isHome = l.href === base;
					const active = isHome ? path === base : path.startsWith(l.href);
					return (
						<a
							href={l.href}
							class:list={[
								'rounded-full bg-[#171717] px-4 py-2 text-sm font-medium text-white transition-all hover:bg-gray-800',
								active ? 'ring-1 ring-white/40' : '',
							]}
						>
							{l.label}
						</a>
					);
				})
			}
		</div>
	</nav>
</header>